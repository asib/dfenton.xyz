export enum LoftGuideDerivativeType
{
    annotation { "Name" : "None" }
    DEFAULT,
    annotation { "Name" : "Normal to guide" }
    NORMAL_TO_GUIDE,
    annotation { "Name" : "Tangent to guide" }
    TANGENT_TO_GUIDE,
    annotation { "Name" : "Match tangent" }
    MATCH_TANGENT,
    annotation { "Name" : "Match curvature" }
    MATCH_CURVATURE
}

