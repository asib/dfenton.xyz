 * @example `min([1 * inch, 2 * inch, 3 * inch])` equals `1 * inch`
 */
export function min(arr is array)
{
    var minVal = undefined;
    for (var entry in arr)
    {
        if (minVal == undefined || entry < minVal)
        {
            minVal = entry;
