 * annotation { "Name" : "Bodies", "Filter" : EntityType.BODY && AllowFlattenedGeometry.YES }
 * definition.body is Query;
 * ```
 *
 * @value YES : Allow flat entities
 * @value NO  : Disallow flat entities
 */
export enum AllowFlattenedGeometry
{
    YES,
    NO
