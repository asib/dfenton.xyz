 *
 * @value REFERENCE_ENTITY : Draft faces holding a specific reference entity constant for each face.
 * @value REFERENCE_SURFACE : Draft faces relative to a single neutral surface.
 * @internal @value NEUTRAL_PLANE : Deprecated. Draft faces relative to a neutral plane.
 */
export enum DraftType
{
    NEUTRAL_PLANE,
    REFERENCE_ENTITY,
    REFERENCE_SURFACE
}

