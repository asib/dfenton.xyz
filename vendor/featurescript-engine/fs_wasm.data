export import(path : "onshape/std/booleanoperationtype.gen.fs", version : "3112.0");
export import(path : "onshape/std/splitoperationkeeptype.gen.fs", version : "3112.0");
import(path : "onshape/std/feature.fs", version : "3112.0");
