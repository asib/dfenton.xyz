import(path : "onshape/std/boundingtype.gen.fs", version : "3112.0");
import(path : "onshape/std/chamfer.fs", version : "3112.0");
import(path : "onshape/std/containers.fs", version : "3112.0");
import(path : "onshape/std/cutlistMath.fs", version : "3112.0");
import(path : "onshape/std/curveGeometry.fs", version : "3112.0");
import(path : "onshape/std/coordSystem.fs", version : "3112.0");
import(path : "onshape/std/error.fs", version : "3112.0");
import(path : "onshape/std/evaluate.fs", version : "3112.0");
import(path : "onshape/std/feature.fs", version : "3112.0");
import(path : "onshape/std/frameAttributes.fs", version : "3112.0");
import(path : "onshape/std/frameUtils.fs", version : "3112.0");
