import(path : "onshape/std/attributes.fs", version : "3112.0");
import(path : "onshape/std/containers.fs", version : "3112.0");
import(path : "onshape/std/context.fs", version : "3112.0");
import(path : "onshape/std/coordSystem.fs", version : "3112.0");
import(path : "onshape/std/imagemappingtype.gen.fs", version : "3112.0");
import(path : "onshape/std/math.fs", version : "3112.0");
import(path : "onshape/std/persistentCoordSystem.fs", version : "3112.0");
import(path : "onshape/std/query.fs", version : "3112.0");
import(path : "onshape/std/string.fs", version : "3112.0");
