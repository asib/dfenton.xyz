export enum EdgeConvexityType
{
    annotation {"Name" : "Convex"}
    CONVEX,
    annotation {"Name" : "Concave"}
    CONCAVE,
    annotation {"Name" : "Smooth"}
    SMOOTH,
    annotation {"Name" : "Variable"}
    VARIABLE
}

