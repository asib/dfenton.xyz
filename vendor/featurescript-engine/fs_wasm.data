 * A `string` representing a foreign element, such as the `dataId` from an
 * imported tab.
 * @type {string}
 */
export type ForeignId typecheck canBeForeignId;

/** Typecheck for [ForeignId] */
export predicate canBeForeignId(value)
{
    value is string;
    //TODO: other checks
