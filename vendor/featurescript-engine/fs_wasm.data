    POINT,
    CENTROID,
    CENTER,
    MID_POINT,
    TOP_AXIS_POINT,
    MID_AXIS_POINT,
    BOTTOM_AXIS_POINT,
    ORIGIN_X,
    ORIGIN_Y,
    ORIGIN_Z,
    LOOP_CENTER,
    VIRTUAL_SHARP
}

