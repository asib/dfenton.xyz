                    "isPeriodic" : bspline.isPeriodic,
                    "controlPoints" : bspline.controlPoints,
                    "knots" : bspline.knots,
                    "weights" : bspline.weights });

        opCreateBSplineCurve(context, id + "bSplineCurve", {
