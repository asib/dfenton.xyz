/** @internal */
export function getFitToleranceTable(isANSI is boolean, isHoleBasis is boolean) returns map
{
    return isANSI ? (isHoleBasis ? ANSI_HoleFitToleranceTable : ANSI_ShaftFitToleranceTable) :
                    (isHoleBasis ? ISO_HoleFitToleranceTable : ISO_ShaftFitToleranceTable);
}

