{
    var data = @evCornerType(context, arg);

    if (isAtVersionOrLater(context, FeatureScriptVersionNumber.V488_CLASSIFY_CORNER_RETURNS_MAP))
    {
        var allVertices = [];
        if (data.allVertices != undefined)
        {
            for (var vert in data.allVertices)
