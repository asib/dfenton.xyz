 * @value NEW : Creates a new surface in the context with the geometry resulting
 *          from the operation.
 * @value ADD : Performs a surface union between the new surface and all surfaces
 *          used as input.
 */
export enum NewSurfaceOperationType
{
    annotation { "Name" : "New" }
    NEW,
    annotation { "Name" : "Add" }
    ADD
}
