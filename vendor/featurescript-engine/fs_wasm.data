/**
 * Integer bound for segment index in segment edit mode.
 */
export const POINT_INDEX_BOUNDS =
{
            (unitless) : [0, 0, 10000]
        } as IntegerBoundSpec;

/**
 * Integer bound for segment index in segment edit mode.
 */
