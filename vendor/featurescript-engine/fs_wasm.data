    annotation { "Name" : "0.123" }
    THOUSANDTHS,

    annotation { "Name" : "0.1234" }
    TEN_THOUSANDTHS,

    annotation { "Name" : "0.12345" }
    HUNDRED_THOUSANDTHS,

    annotation { "Name" : "0.123456" }
