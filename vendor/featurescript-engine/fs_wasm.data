export import(path : "onshape/std/surfaceGeometry.fs", version : "3112.0");

// Imports used internally
import(path : "onshape/std/attributes.fs", version : "3112.0");
import(path : "onshape/std/booleanoperationtype.gen.fs", version : "3112.0");
